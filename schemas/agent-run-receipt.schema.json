{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jg-noncelogic/knowledge-worker-agent-rollout-kit/schemas/agent-run-receipt.schema.json",
  "title": "Knowledge-worker agent run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "started_at", "completed_at", "workflow", "rung", "actor", "inputs", "actions", "outputs", "evidence", "outcome", "review"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "workflow": {"type": "string", "minLength": 1},
    "rung": {"type": "integer", "minimum": 0, "maximum": 4},
    "actor": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "outcome": {"enum": ["completed", "failed", "stopped"]},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "edit_minutes", "unsupported_claims", "reversal", "notes"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "edited", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "measurement_mode": {"enum": ["exact", "rounded", "bucketed", "unassessed"]},
        "edit_minutes": {"type": ["number", "null"], "minimum": 0},
        "edit_minutes_bucket": {"enum": ["0", "1-5", "6-15", "16-30", "31+", null]},
        "voluntary_reuse": {"type": ["boolean", "null"]},
        "unsupported_claims": {"type": "integer", "minimum": 0},
        "reversal": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"required": ["measurement_mode"], "properties": {"status": {"const": "pending"}}},
          "then": {"properties": {"edit_minutes": {"const": null}, "edit_minutes_bucket": {"const": null}, "voluntary_reuse": {"const": null}}}
        },
        {
          "if": {"required": ["measurement_mode"], "properties": {"measurement_mode": {"enum": ["exact", "rounded"]}, "status": {"not": {"const": "pending"}}}},
          "then": {"properties": {"edit_minutes": {"type": "number", "minimum": 0}, "edit_minutes_bucket": {"const": null}}}
        },
        {
          "if": {"required": ["measurement_mode"], "properties": {"measurement_mode": {"const": "rounded"}, "status": {"not": {"const": "pending"}}}},
          "then": {"properties": {"edit_minutes": {"type": "number", "minimum": 0, "multipleOf": 5}}}
        },
        {
          "if": {"required": ["measurement_mode"], "properties": {"measurement_mode": {"const": "bucketed"}, "status": {"not": {"const": "pending"}}}},
          "then": {"required": ["edit_minutes_bucket"], "properties": {"edit_minutes": {"const": null}, "edit_minutes_bucket": {"enum": ["0", "1-5", "6-15", "16-30", "31+"]}}}
        },
        {
          "if": {"required": ["measurement_mode"], "properties": {"measurement_mode": {"const": "unassessed"}}},
          "then": {"properties": {"edit_minutes": {"const": null}, "edit_minutes_bucket": {"const": null}}}
        }
      ]
    }
  }
}
